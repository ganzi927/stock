# 선택 사항: 한국은행 ECOS Open API 키 (https://ecos.bok.or.kr 에서 무료 발급)
# 설정하면 Credit Spread 지표가 실제 금리 데이터로 계산됩니다. 없으면 N/A 처리.
ECOS_API_KEY=

# 선택 사항: KRX Open API 인증키 (https://openapi.krx.co.kr 무료 회원가입 후 발급)
# 설정하면 Volatility(VKOSPI 실제값), Put/Call Ratio, Breadth, Strength가
# 근사치(proxy) 대신 실제 데이터로 계산됩니다. 발급 후 아래 3개 API에 대해
# 마이페이지가 아니라 각 API 상세페이지의 "API 이용신청" 버튼을 눌러 개별
# 승인(즉시 자동승인)까지 받아야 합니다: 옵션 일별매매정보(opt_bydd_trd),
# 파생상품지수 시세정보(drvprod_dd_trd), 유가증권 일별매매정보(stk_bydd_trd).
KRX_API_KEY=

# 선택 사항: Anthropic API 키 (https://console.anthropic.com 에서 발급, 유료 — 사용한 만큼 과금)
# 설정하면 각 섹션(공포탐욕지수/코스피200 옵션 2개/삼성전자·SK하이닉스)에 초보자용 AI 해설과
# 4번째 "종합 전망" 탭이 추가됩니다 (Haiku 4.5, 하루 6콜, 월 $1 안팎). 없으면 숫자/차트만.
ANTHROPIC_API_KEY=

# LLM 완전 차단 스위치. 0/off/false 이면 ANTHROPIC_API_KEY 가 있어도 AI 코멘트/전망을
# 전혀 생성하지 않습니다 (비용 0). 비워두거나 1이면 정상 동작.
KFGI_AI=

# 연구용 옵션 해설은 기본 비활성. 기본 종합 AI와 분리됨.
KFGI_RESEARCH_AI=0
